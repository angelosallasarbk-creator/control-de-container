# Banco PostgreSQL.
# Desenvolvimento local: suba o banco com `docker compose up -d` e use a URL abaixo.
# Produção (Render): use a connection string do Postgres de produção (ex.: Supabase "Session pooler", porta 5432).
DATABASE_URL="postgresql://container_user:container_pass_dev@localhost:5433/controle_container"

PORT=3000

# Segredo que assina o cookie de sessão (JWT). Gere um valor próprio:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-proprio"

# Intervalo (em minutos) do verificador que recalcula prazos e gera/encerra alertas.
VERIFICADOR_INTERVALO_MINUTOS=5
