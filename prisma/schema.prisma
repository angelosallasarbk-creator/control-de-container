generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  SUPERVISOR
  OPERADOR
  VISUALIZACAO
  TRANSPORTADOR // só telas do QR; ao ler a etiqueta registra a coleta (local de retirada)
  PORTARIA // QR + Pátio (consulta); ao ler a etiqueta registra entrada/saída no ponto de carregamento
  GESTOR_TRANSPORTADORA // só a tela de Motoristas da própria transportadora (bloquear, sessões, importar)
  PLATAFORMA // administrador da plataforma: cria organizações e o 1º admin; não vê dados dos clientes
}

// Ciclo de exportação: retira vazio no porto → ova na fábrica → entrega cheio no terminal.
enum StatusContainer {
  PROGRAMADO
  COLETADO // retirado no porto: inicia a contagem de demurrage
  NA_FABRICA // chegou na fábrica: inicia a contagem de estadia
  EM_OPERACAO // em ovação (carregamento) na doca
  LIBERADO // ovado e lacrado, aguardando saída
  SAIU_FABRICA // encerra a estadia
  ENTREGUE_PORTO // entregue no terminal: encerra a demurrage
  CANCELADO
}

enum TipoContainer {
  DRY_20
  DRY_40
  HC_40
  REEFER_20
  REEFER_40
}

enum TipoAlerta {
  ESTADIA
  DEMURRAGE
  DEADLINE
  TEMPERATURA
  SEM_LEITURA
  RISCO_DEMURRAGE // previsão de entrega passa do free time
  RISCO_DEADLINE // previsão de entrega passa do deadline do navio
  ATRASO_COLETA // passou a data/hora programada da coleta e o container segue Programado
}

// Onde o tipo de local pode ser usado no trajeto do container.
enum FuncaoLocal {
  RETIRADA_ENTREGA // retirada do vazio / entrega do cheio (porto, terminal ferroviário…); tem fila/gate
  CARREGAMENTO // onde o container é ovado (fábrica, armazém…)
  PARADA // ponto intermediário do trajeto (ex.: Ponto Fiscal): tempo de parada; passagem registrada
}

// Ação de cada etapa do fluxo de um Tipo de Operação. Cada ação (menos PASSAGEM) corresponde a um
// status do container; PASSAGEM vira um ponto de parada do trajeto (ParadaContainer).
enum AcaoEtapa {
  COLETA // → COLETADO
  CHEGADA // → NA_FABRICA (chegada ao local de operação)
  INICIO_OPERACAO // → EM_OPERACAO (ovação/desova)
  LIBERACAO // → LIBERADO
  SAIDA // → SAIU_FABRICA
  PASSAGEM // ponto de parada
  ENTREGA // → ENTREGUE_PORTO
}

// Onde um ponto de parada fica no trajeto, em relação ao ponto de carregamento.
enum PosicaoParada {
  ANTES_CARREGAMENTO
  APOS_CARREGAMENTO
}

enum NivelAlerta {
  ATENCAO
  CRITICO
}

enum OrigemLeitura {
  MANUAL
  INTEGRACAO
  QRCODE // lançada pelo celular lendo a etiqueta do container
}

// LIVRE = impressa, ainda sem container; VINCULADA = ligada a uma passagem de container;
// CANCELADA = substituída/inutilizada. "Encerrada" não é gravada: é deduzida quando o container
// da etiqueta foi entregue ou cancelado (a etiqueta vai colada nele e vale para uma viagem).
enum StatusEtiqueta {
  LIVRE
  VINCULADA
  CANCELADA
}

model Usuario {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0). Vazio: plataforma.
  organizacaoId      Int?
  organizacao        Organizacao? @relation(fields: [organizacaoId], references: [id])
  id                 Int          @id @default(autoincrement())
  email              String       @unique
  nome               String
  senhaHash          String
  perfil             Perfil       @default(VISUALIZACAO)
  // Permissões personalizadas (lista de chaves de src/lib/permissoes.js). null = padrão do perfil.
  permissoes         Json?
  // Sessões (tokens) emitidas antes deste instante deixam de valer — ex.: senha redefinida.
  // Assim um "lembrar meu login" (sessão de 30 dias) não sobrevive à troca de senha.
  sessoesValidasApos DateTime?
  // "Esqueci minha senha": só o HASH (SHA-256) do código do link fica no banco; uso único,
  // expira em 30 min; um pedido novo substitui o anterior.
  resetTokenHash     String?      @unique
  resetExpiraEm      DateTime?
  resetSolicitadoEm  DateTime?
  // Celular para SMS (formato E.164, ex.: +5511987654321). Lido no momento de cada envio.
  celular            String?
  ativo              Boolean      @default(true)
  criadoEm           DateTime     @default(now())

  rastreiosResponsavel Container[]          @relation("RastreioResponsavel")
  posicoesEnviadas     PosicaoContainer[]
  solicitacoesPosicao  SolicitacaoPosicao[]
  mensagensSms         MensagemSms[]
  // Perfil Gestor da transportadora: de qual transportadora ele cuida dos motoristas.
  transportadoraId     Int?
  transportadora       Transportadora?      @relation(fields: [transportadoraId], references: [id])

  @@index([organizacaoId])
}

// Região agrupa fábricas; cada região vira uma aba no Pátio.
model Regiao {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao     @relation(fields: [organizacaoId], references: [id])
  id            Int             @id @default(autoincrement())
  nome          String
  ativo         Boolean         @default(true)
  criadoEm      DateTime        @default(now())
  grupos        GrupoOperacao[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

// Grupo de operação = Ponto de Carregamento (Cliente + Fábrica). Cada grupo tem sua meta de estadia.
// A região é da fábrica: todos os grupos da mesma fábrica ficam na mesma região
// (garantido na validação do cadastro, ver routes/cadastros.js).
model GrupoOperacao {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId       Int
  organizacao         Organizacao    @relation(fields: [organizacaoId], references: [id])
  id                  Int            @id @default(autoincrement())
  cliente             String
  fabrica             String
  regiaoId            Int?
  regiao              Regiao?        @relation(fields: [regiaoId], references: [id])
  // Local físico padrão de carregamento (endereço/coordenadas) usado na previsão de rota.
  localId             Int?
  local               Local?         @relation(fields: [localId], references: [id])
  metaEstadiaHoras    Int
  alertaEstadiaHoras  Int            @default(6) // avisa quando faltarem X horas para vencer a meta
  custoEstadiaPorHora Decimal?       @db.Decimal(12, 2)
  // Pode ser ponto de parada no trajeto de outros containers (Editar trajeto): usa o local acima,
  // com posição padrão (antes/depois do carregamento) e tempo médio de parada.
  podeSerParada       Boolean        @default(false)
  posicaoParada       PosicaoParada?
  tempoParadaHoras    Decimal?       @db.Decimal(5, 1)
  ativo               Boolean        @default(true)
  criadoEm            DateTime       @default(now())
  containers          Container[]

  @@unique([organizacaoId, cliente, fabrica])
  @@index([regiaoId])
  @@index([organizacaoId])
}

// Tipo de local cadastrável (Fábrica, Armazém, Porto / Terminal, Terminal Ferroviário…).
// Os rótulos dão nome às etapas do container que acontecem nesse tipo de local
// (ex.: "Coleta ferroviária"); só os da função do tipo são usados.
model TipoLocal {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id])
  id            Int          @id @default(autoincrement())
  nome          String
  funcao        FuncaoLocal
  rotuloColeta  String? // RETIRADA_ENTREGA
  rotuloEntrega String? // RETIRADA_ENTREGA
  rotuloChegada String? // CARREGAMENTO
  rotuloSaida   String? // CARREGAMENTO
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  locais        Local[]
  etapasFluxo   EtapaFluxo[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

// Tipo de Operação (Exportação padrão, Coleta de cheio, Importação, Transferência…): define o fluxo
// de etapas do container. O fluxo é copiado para Container.fluxo na criação do container.
model TipoOperacao {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId  Int
  organizacao    Organizacao     @relation(fields: [organizacaoId], references: [id])
  id             Int             @id @default(autoincrement())
  nome           String
  descricao      String?
  ativo          Boolean         @default(true)
  padrao         Boolean         @default(false) // usado quando o container não informa o tipo
  // Etapas que abrem e fecham o free time do armador (demurrage).
  freeTimeInicio StatusContainer @default(COLETADO)
  freeTimeFim    StatusContainer @default(ENTREGUE_PORTO)
  criadoEm       DateTime        @default(now())
  etapas         EtapaFluxo[]
  containers     Container[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

// Etapa do fluxo de um Tipo de Operação, em ordem. O local pode ser restrito por função
// (ex.: qualquer porto/terminal) ou por um tipo de local específico, com um local sugerido.
model EtapaFluxo {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId   Int
  organizacao     Organizacao  @relation(fields: [organizacaoId], references: [id])
  id              Int          @id @default(autoincrement())
  tipoOperacaoId  Int
  tipoOperacao    TipoOperacao @relation(fields: [tipoOperacaoId], references: [id], onDelete: Cascade)
  ordem           Int
  acao            AcaoEtapa
  nome            String? // nome livre da etapa (ex.: "Coleta do cheio na fábrica")
  funcaoLocal     FuncaoLocal?
  tipoLocalId     Int?
  tipoLocal       TipoLocal?   @relation(fields: [tipoLocalId], references: [id])
  localSugeridoId Int?
  localSugerido   Local?       @relation("LocalSugeridoEtapa", fields: [localSugeridoId], references: [id])

  @@index([tipoOperacaoId])
  @@index([organizacaoId])
}

// Ponto físico do trajeto; o tipo define se é carregamento ou retirada/entrega.
model Local {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId    Int
  organizacao      Organizacao    @relation(fields: [organizacaoId], references: [id])
  id               Int            @id @default(autoincrement())
  nome             String
  tipoId           Int
  tipo             TipoLocal      @relation(fields: [tipoId], references: [id])
  endereco         String?
  cidade           String?
  uf               String?
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  filaHoras        Decimal?       @db.Decimal(5, 1) // porto: fila/gate; vazio = padrão das Configurações
  // Ponto de parada (função PARADA): posição padrão no trajeto e tempo médio parado (entra no ETA).
  posicaoParada    PosicaoParada?
  tempoParadaHoras Decimal?       @db.Decimal(5, 1)
  ativo            Boolean        @default(true)
  criadoEm         DateTime       @default(now())

  grupos            GrupoOperacao[]
  retiradas         Container[]       @relation("PortoRetirada")
  carregamentos     Container[]       @relation("LocalCarregamento")
  entregas          Container[]       @relation("PortoEntrega")
  distanciasOrigem  DistanciaRota[]   @relation("Origem")
  distanciasDestino DistanciaRota[]   @relation("Destino")
  paradas           ParadaContainer[]
  etapasSugeridas   EtapaFluxo[]      @relation("LocalSugeridoEtapa")

  @@unique([organizacaoId, nome])
  @@index([tipoId])
  @@index([organizacaoId])
}

// Cache da distância rodoviária entre dois locais (calculada uma vez; recalculada se as
// coordenadas mudarem). fonte: ORS = rota de caminhão; ESTIMADA = linha reta × fator.
model DistanciaRota {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  id            Int         @id @default(autoincrement())
  origemId      Int
  origem        Local       @relation("Origem", fields: [origemId], references: [id], onDelete: Cascade)
  destinoId     Int
  destino       Local       @relation("Destino", fields: [destinoId], references: [id], onDelete: Cascade)
  distanciaKm   Decimal     @db.Decimal(8, 1)
  fonte         String
  calculadoEm   DateTime    @default(now())

  @@unique([origemId, destinoId])
  @@index([organizacaoId])
}

// Armador = dono do container; define o free time e o valor da diária de demurrage.
model Armador {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId       Int
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id])
  id                  Int         @id @default(autoincrement())
  nome                String
  freeTimeDias        Int
  valorDiaria         Decimal     @db.Decimal(12, 2)
  moeda               String      @default("USD")
  alertaDemurrageDias Int         @default(2) // avisa quando faltarem X dias para vencer o free time
  ativo               Boolean     @default(true)
  criadoEm            DateTime    @default(now())
  containers          Container[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

// Produto = faixa de temperatura padrão para reefer.
// Categoria da carga: Congelado e Refrigerado têm faixa de temperatura (controle no reefer);
// Carga Seca não tem temperatura (sem leitura no QR, sem aba/alerta de temperatura).
enum CategoriaProduto {
  CONGELADO
  REFRIGERADO
  CARGA_SECA
}

model Produto {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId     Int
  organizacao       Organizacao      @relation(fields: [organizacaoId], references: [id])
  id                Int              @id @default(autoincrement())
  nome              String
  categoria         CategoriaProduto @default(REFRIGERADO)
  setpoint          Decimal?         @db.Decimal(5, 1) // vazio em Carga Seca
  tempMin           Decimal?         @db.Decimal(5, 1)
  tempMax           Decimal?         @db.Decimal(5, 1)
  toleranciaMinutos Int              @default(30) // fora da faixa por mais que isso vira CRÍTICO
  ativo             Boolean          @default(true)
  criadoEm          DateTime         @default(now())
  containers        Container[]

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

// Uma "passagem" do container pelo processo (coleta → entrega). O mesmo número físico pode
// voltar em outra exportação, por isso o número não é único; só pode haver uma passagem ativa.
// Índice único PARCIAL "Container_numero_ativo_unico" (organizacaoId, numero) WHERE status ativo — criado
// por SQL na migração 20261006100000_seguranca_3_2; o Prisma 5 não o representa. Não remover.
model Container {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId       Int
  organizacao         Organizacao     @relation(fields: [organizacaoId], references: [id])
  id                  Int             @id @default(autoincrement())
  numero              String
  tipo                TipoContainer
  status              StatusContainer @default(PROGRAMADO)
  grupoId             Int
  grupo               GrupoOperacao   @relation(fields: [grupoId], references: [id])
  armadorId           Int
  armador             Armador         @relation(fields: [armadorId], references: [id])
  produtoId           Int?
  produto             Produto?        @relation(fields: [produtoId], references: [id])
  // Tipo de Operação e cópia do seu fluxo na criação (etapas, nomes, free time, regras de local).
  // fluxo vazio = fluxo de exportação de sempre (containers anteriores à v2.0).
  tipoOperacaoId      Int?
  tipoOperacao        TipoOperacao?   @relation(fields: [tipoOperacaoId], references: [id])
  fluxo               Json?
  // Trajeto: porto de retirada do vazio → local de carregamento → porto de entrega do cheio.
  portoRetiradaId     Int?
  portoRetirada       Local?          @relation("PortoRetirada", fields: [portoRetiradaId], references: [id])
  localCarregamentoId Int?
  localCarregamento   Local?          @relation("LocalCarregamento", fields: [localCarregamentoId], references: [id])
  portoEntregaId      Int?
  portoEntrega        Local?          @relation("PortoEntrega", fields: [portoEntregaId], references: [id])
  booking             String?
  lacre               String?
  navio               String?
  deadline            DateTime? // cut-off de entrega no terminal
  coletaProgramadaEm  DateTime? // data/hora programada da coleta (passou sem coleta → alerta de atraso)
  // Plano congelado: primeira previsão completa (coleta, chegada, saída, entrega), gravada uma vez
  // e nunca alterada — base do "Planejado" × "Realizado" da aba Etapas.
  planejamento        Json?
  placa               String?
  motorista           String?
  posicaoPatio        String?
  observacao          String?

  // Prazos copiados dos cadastros no momento da criação: mudar o contrato do armador ou a meta
  // do grupo depois não altera retroativamente containers já em andamento.
  metaEstadiaHoras    Int
  alertaEstadiaHoras  Int
  custoEstadiaPorHora Decimal? @db.Decimal(12, 2)
  freeTimeDias        Int
  valorDiaria         Decimal  @db.Decimal(12, 2)
  moeda               String
  alertaDemurrageDias Int
  setpoint            Decimal? @db.Decimal(5, 1)
  tempMin             Decimal? @db.Decimal(5, 1)
  tempMax             Decimal? @db.Decimal(5, 1)
  toleranciaMinutos   Int?

  coletadoEm       DateTime?
  chegadaFabricaEm DateTime?
  inicioOperacaoEm DateTime?
  liberadoEm       DateTime?
  saidaFabricaEm   DateTime?
  entreguePortoEm  DateTime?
  canceladoEm      DateTime?

  criadoEm     DateTime @default(now())
  criadoPor    String
  atualizadoEm DateTime @updatedAt

  eventos         EventoContainer[]
  leituras        LeituraTemperatura[]
  alertas         Alerta[]
  etiquetas       EtiquetaQR[]
  // Pontos de parada do trajeto (ex.: Ponto Fiscal), em ordem, antes ou depois do carregamento.
  paradas         ParadaContainer[]
  // Mudanças no trajeto (locais e paradas) — aba Histórico da ficha.
  mudancasTrajeto MudancaTrajeto[]

  // Rastreamento por SMS: quem registrou algo pelo QR por último recebe os pedidos de posição.
  rastreioResponsavelId  Int?
  rastreioResponsavel    Usuario?             @relation("RastreioResponsavel", fields: [rastreioResponsavelId], references: [id])
  // …ou um motorista (acesso pelo celular, sem usuário). Só um dos dois fica preenchido.
  rastreioMotoristaId    Int?
  rastreioMotorista      Motorista?           @relation("RastreioMotorista", fields: [rastreioMotoristaId], references: [id])
  rastreioDesde          DateTime?
  rastreioUltimoEnvioEm  DateTime? // último SMS (vínculo ou pedido de posição) — base do próximo
  // Acompanhamento pela página do link (v3.1.2): ATIVO | PAUSADO (página minimizada/fechada) |
  // ENCERRADO (motorista tocou em Parar); quando mudou; último sinal recebido da página.
  acompanhamentoEstado   String?
  acompanhamentoEstadoEm DateTime?
  acompanhamentoSinalEm  DateTime?
  posicoes               PosicaoContainer[]
  solicitacoesPosicao    SolicitacaoPosicao[]
  mensagensSms           MensagemSms[]

  @@index([numero])
  @@index([status])
  @@index([grupoId])
  @@index([localCarregamentoId])
  @@index([organizacaoId])
}

model EventoContainer {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao      @relation(fields: [organizacaoId], references: [id])
  id            Int              @id @default(autoincrement())
  containerId   Int
  container     Container        @relation(fields: [containerId], references: [id], onDelete: Cascade)
  statusDe      StatusContainer?
  statusPara    StatusContainer
  ocorridoEm    DateTime // quando aconteceu de fato (pode ser informado retroativamente)
  registradoEm  DateTime         @default(now())
  usuarioEmail  String
  observacao    String?

  @@index([containerId])
  @@index([organizacaoId])
}

model LeituraTemperatura {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao   @relation(fields: [organizacaoId], references: [id])
  id            Int           @id @default(autoincrement())
  containerId   Int
  container     Container     @relation(fields: [containerId], references: [id], onDelete: Cascade)
  temperatura   Decimal       @db.Decimal(5, 1)
  lidaEm        DateTime
  origem        OrigemLeitura
  fonte         String? // e-mail do operador ou nome do token de integração
  registradaEm  DateTime      @default(now())
  // Leitura pela etiqueta QR: qual etiqueta e (se o celular permitiu) onde foi feita.
  etiquetaId    Int?
  etiqueta      EtiquetaQR?   @relation(fields: [etiquetaId], references: [id])
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  precisaoM     Int?

  // Reenvio da mesma leitura (mesmo container e horário) não duplica.
  @@unique([containerId, lidaEm])
  @@index([containerId, lidaEm])
  @@index([organizacaoId])
}

// Lote de etiquetas geradas de uma vez (para reimprimir e rastrear quem gerou).
model LoteEtiquetas {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id])
  id            Int          @id @default(autoincrement())
  quantidade    Int
  criadoEm      DateTime     @default(now())
  criadoPor     String
  etiquetas     EtiquetaQR[]

  // Cada usuário só vê/imprime as etiquetas dos lotes que ele gerou.
  @@index([criadoPor])
  @@index([organizacaoId])
}

// Etiqueta QR colada no container. O QR leva uma URL com o `token` (longo, impossível de
// adivinhar); o `codigo` curto (ex.: CC-7K3F9P) vai impresso para leitura humana/digitação.
model EtiquetaQR {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId      Int
  organizacao        Organizacao          @relation(fields: [organizacaoId], references: [id])
  id                 Int                  @id @default(autoincrement())
  codigo             String               @unique
  token              String               @unique
  loteId             Int
  lote               LoteEtiquetas        @relation(fields: [loteId], references: [id])
  status             StatusEtiqueta       @default(LIVRE)
  containerId        Int?
  container          Container?           @relation(fields: [containerId], references: [id])
  vinculadaEm        DateTime?
  vinculadaPor       String?
  canceladaEm        DateTime?
  canceladaPor       String?
  motivoCancelamento String?
  // Controle de impressão: evita imprimir a mesma etiqueta duas vezes sem perceber.
  vezesImpressa      Int                  @default(0)
  impressaEm         DateTime?
  impressaPor        String?
  criadoEm           DateTime             @default(now())
  leituras           LeituraTemperatura[]

  @@index([containerId])
  @@index([loteId])
  @@index([status])
  @@index([organizacaoId])
}

model Alerta {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId  Int
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id])
  id             Int         @id @default(autoincrement())
  containerId    Int
  container      Container   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  tipo           TipoAlerta
  nivel          NivelAlerta
  mensagem       String
  abertoEm       DateTime    @default(now())
  encerradoEm    DateTime? // a condição deixou de existir
  reconhecidoEm  DateTime?
  reconhecidoPor String?
  acaoTomada     String?
  // Preenchida só enquanto o alerta está aberto ("containerId:tipo:nivel"). O índice único
  // impede abrir o mesmo alerta duas vezes (idempotência do verificador).
  chaveAberta    String?     @unique

  @@index([containerId])
  @@index([encerradoEm])
  @@index([organizacaoId])
}

model TokenIntegracao {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  id            Int         @id @default(autoincrement())
  nome          String
  prefixo       String // primeiros caracteres, só para identificar na tela
  tokenHash     String      @unique
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now())
  criadoPor     String
  ultimoUsoEm   DateTime?

  @@index([organizacaoId])
}

model Configuracao {
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  chave         String
  valor         String

  @@id([organizacaoId, chave])
}

model LogAuditoria {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0). Vazio: plataforma.
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])
  id            Int          @id @default(autoincrement())
  usuarioEmail  String
  acao          String
  entidade      String
  entidadeId    String?
  descricao     String
  dadosAntes    String?
  dadosDepois   String?
  criadoEm      DateTime     @default(now())

  @@index([criadoEm])
  @@index([organizacaoId])
}

// Posição GPS do container: enviada pelo link do SMS ou junto de uma leitura do QR.
model PosicaoContainer {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  id            Int         @id @default(autoincrement())
  containerId   Int
  container     Container   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuarioId     Int?
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  motoristaId   Int?
  motorista     Motorista?  @relation(fields: [motoristaId], references: [id])
  latitude      Decimal     @db.Decimal(9, 6)
  longitude     Decimal     @db.Decimal(9, 6)
  precisaoM     Int?
  origem        String // LINK_SMS | QR
  etapa         String // status do container no momento
  registradaEm  DateTime    @default(now())

  @@index([containerId, registradaEm])
  @@index([organizacaoId])
}

// Um pedido de posição enviado por SMS. O link leva um código aleatório; só o hash fica aqui.
model SolicitacaoPosicao {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  id            Int         @id @default(autoincrement())
  containerId   Int
  container     Container   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  // Destinatário: usuário OU motorista.
  usuarioId     Int?
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  motoristaId   Int?
  motorista     Motorista?  @relation(fields: [motoristaId], references: [id])
  tokenHash     String      @unique
  criadaEm      DateTime    @default(now())
  expiraEm      DateTime
  respondidaEm  DateTime?
  motivo        String? // por que foi pedido (trecho crítico, intervalo, manual…)

  @@index([containerId])
  @@index([organizacaoId])
}

// Registro de cada SMS (enviado, simulado, falha ou sem celular): conferência e custo.
model MensagemSms {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0). Vazio: plataforma.
  organizacaoId Int?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])
  id            Int          @id @default(autoincrement())
  containerId   Int?
  container     Container?   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuarioId     Int?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])
  motoristaId   Int?
  motorista     Motorista?   @relation(fields: [motoristaId], references: [id])
  telefone      String?
  tipo          String // VINCULO | POSICAO
  status        String // ENVIADA | SIMULADA | FALHA | SEM_CELULAR
  texto         String
  erro          String?
  motivo        String? // pedidos de posição: por que foi pedido
  criadaEm      DateTime     @default(now())

  @@index([containerId, criadaEm])
  @@index([organizacaoId])
}

// Transportadora: agrupa os motoristas; o Gestor da transportadora cuida só dos dela.
model Transportadora {
  id           Int                         @id @default(autoincrement())
  nome         String                      @unique
  cnpj         String?
  ativo        Boolean                     @default(true)
  criadoEm     DateTime                    @default(now())
  motoristas   Motorista[]
  gestores     Usuario[]
  organizacoes TransportadoraOrganizacao[]
}

// Motorista: NÃO é usuário do sistema. Identidade = celular verificado por código SMS; acessa só
// as telas do QR. Cadastro livre no primeiro acesso (ou importado pelo gestor); o gestor bloqueia.
model Motorista {
  id               Int            @id @default(autoincrement())
  nome             String
  celular          String         @unique // E.164 (+55…)
  cpf              String?
  placa            String?
  transportadoraId Int
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id])
  bloqueado        Boolean        @default(false)
  bloqueadoEm      DateTime?
  bloqueadoPor     String?
  consentimentoEm  DateTime? // aceite do termo (LGPD) no primeiro acesso; null = importado, ainda não aceitou
  ultimoAcessoEm   DateTime?
  criadoEm         DateTime       @default(now())
  criadoPor        String? // null = cadastrou-se pelo QR; senão, quem importou/cadastrou

  sessoes             SessaoMotorista[]
  organizacoes        MotoristaOrganizacao[]
  rastreios           Container[]            @relation("RastreioMotorista")
  posicoes            PosicaoContainer[]
  solicitacoesPosicao SolicitacaoPosicao[]
  mensagensSms        MensagemSms[]

  @@index([transportadoraId])
}

// Código de 6 dígitos enviado por SMS para entrar (vale 15 min; pedir outro encerra o anterior).
// Só o hash (HMAC) fica no banco.
model CodigoAcessoMotorista {
  id          Int       @id @default(autoincrement())
  celular     String
  codigoHash  String
  criadoEm    DateTime  @default(now())
  expiraEm    DateTime
  tentativas  Int       @default(0)
  encerradoEm DateTime? // usado, substituído por um novo ou esgotou as tentativas
  ip          String?

  @@index([celular, criadoEm])
}

// Sessão do motorista no celular (cookie httpOnly, 60 dias). Só o hash do token fica no banco.
model SessaoMotorista {
  id          Int       @id @default(autoincrement())
  motoristaId Int
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  criadaEm    DateTime  @default(now())
  expiraEm    DateTime
  ultimoUsoEm DateTime?
  revogadaEm  DateTime?
  revogadaPor String?
  dispositivo String? // navegador/celular (User-Agent resumido) — para o gestor reconhecer a sessão

  @@index([motoristaId])
}

// Ponto de parada no trajeto de um container (ex.: Ponto Fiscal). A ordem é a do trajeto dentro da
// fase (antes/depois do carregamento). A passagem é um marco: não muda o status do container.
model ParadaContainer {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId  Int
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id])
  id             Int           @id @default(autoincrement())
  containerId    Int
  container      Container     @relation(fields: [containerId], references: [id], onDelete: Cascade)
  localId        Int
  local          Local         @relation(fields: [localId], references: [id])
  fase           PosicaoParada
  ordem          Int
  passouEm       DateTime?
  registradoPor  String?
  origemRegistro String? // FICHA | QR
  latitude       Decimal?      @db.Decimal(9, 6)
  longitude      Decimal?      @db.Decimal(9, 6)
  precisaoM      Int?
  criadoEm       DateTime      @default(now())

  @@index([containerId])
  @@index([organizacaoId])
}

// Mudança no trajeto do container (retirada, carregamento, entrega ou paradas), com o antes e o
// depois. aposPlanejado = o container já tinha o Planejado (plano congelado) quando mudou.
model MudancaTrajeto {
  // Organização (cliente) dona do registro — filtro automático + RLS (v3.0).
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  id            Int         @id @default(autoincrement())
  containerId   Int
  container     Container   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  ocorridoEm    DateTime    @default(now())
  usuarioEmail  String
  origem        String // FICHA (editar dados) | TRAJETO (Editar trajeto) | QR (leitura da coleta)
  antes         String
  depois        String
  detalhes      Json // ["Entrega: Porto A → Porto B", "+ parada: Posto Fiscal X", …]
  aposPlanejado Boolean

  @@index([containerId])
  @@index([organizacaoId])
}

// Organização = cliente da plataforma (multi-tenant, v3.0). Cada cliente só enxerga os próprios
// dados: filtro automático na aplicação (lib/tenant.js) + Row-Level Security no PostgreSQL.
model Organizacao {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  criadoPor String?

  usuarios            Usuario[]
  regioes             Regiao[]
  grupos              GrupoOperacao[]
  tiposLocal          TipoLocal[]
  tiposOperacao       TipoOperacao[]
  etapasFluxo         EtapaFluxo[]
  locais              Local[]
  distancias          DistanciaRota[]
  armadores           Armador[]
  produtos            Produto[]
  containers          Container[]
  eventos             EventoContainer[]
  leituras            LeituraTemperatura[]
  lotesEtiquetas      LoteEtiquetas[]
  etiquetas           EtiquetaQR[]
  alertas             Alerta[]
  tokensIntegracao    TokenIntegracao[]
  configuracoes       Configuracao[]
  logs                LogAuditoria[]
  posicoes            PosicaoContainer[]
  solicitacoesPosicao SolicitacaoPosicao[]
  mensagensSms        MensagemSms[]
  paradas             ParadaContainer[]
  mudancasTrajeto     MudancaTrajeto[]
  motoristas          MotoristaOrganizacao[]
  transportadoras     TransportadoraOrganizacao[]
}

// Motorista (cadastro único na plataforma) visível para a organização: criado quando ele lê um QR
// ou registra uma carga daquele cliente (ou o cliente o cadastra).
model MotoristaOrganizacao {
  motoristaId   Int
  motorista     Motorista   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  organizacaoId Int
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  desde         DateTime    @default(now())
  // Bloqueio por este cliente (v3.2). O bloqueio em Motorista é o da transportadora (vale para todos).
  bloqueado     Boolean     @default(false)
  bloqueadoEm   DateTime?
  bloqueadoPor  String?

  @@id([motoristaId, organizacaoId])
  @@index([organizacaoId])
}

// Transportadora (global) visível para a organização: quando um motorista dela passa a ser visível
// ou quando o próprio cliente a cadastra.
model TransportadoraOrganizacao {
  transportadoraId Int
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)
  organizacaoId    Int
  organizacao      Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  desde            DateTime       @default(now())

  @@id([transportadoraId, organizacaoId])
  @@index([organizacaoId])
}
